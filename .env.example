APP_NAME="Vale Cuatro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vale_cuatro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Tiempo real (partidas entre dos personas). Con "log" los avisos solo se anotan en el registro y el
# sitio anda igual, sin partidas en vivo. Para tenerlas en tu máquina: poné BROADCAST_CONNECTION=reverb,
# generá las claves con `reverb:install` (con la conexión en null solo para ese comando, porque sin
# claves ningún comando arranca) y prendé el servidor con `php artisan reverb:start`.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Adónde se conecta el navegador, si no es lo mismo que lo de arriba (así es en el sitio publicado,
# donde el sitio le habla a Reverb por adentro y el navegador entra por la dirección pública).
# REVERB_PUBLICO_HOST=
# REVERB_PUBLICO_PORT=443
# REVERB_PUBLICO_SCHEME=https

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# La cuenta que administra el sitio: la crea "php artisan administrador:crear" con estos dos datos.
# Vacíos, nadie administra el sitio y el panel no existe para nadie.
ADMIN_EMAIL=
ADMIN_PASSWORD=
